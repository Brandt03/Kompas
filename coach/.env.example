# Kopiér til .env og udfyld. Kun de tre øverste blokke er nødvendige.

# --- Garmin ---------------------------------------------------------------
# Bruges kun ved første login. Derefter kører alt på gemte tokens, og du kan
# fjerne password-linjen igen.
GARMIN_EMAIL=dig@example.com
GARMIN_PASSWORD=
GARMINTOKENS=~/.garminconnect

# --- Dine tal -------------------------------------------------------------

# Lad dem stå tomme — programmet udleder dem selv fra Garmins profil og dine
# egne målinger. Udfyld kun hvis du vil overstyre med et tal du ved er rigtigt.
GC_HR_MAX=
GC_HR_REST=
GC_SEX=

# --- Kalender -------------------------------------------------------------
# Hemmelig iCal-adresse fra Google/Apple/Outlook, eller sti til en .ics-fil.
# Flere adskilles med komma.
GC_ICS_URLS=

# --- Hevy (valgfrit) ------------------------------------------------------
# API-nøgle fra Hevy → Settings → API (kræver Hevy Pro). Giver sæt, vægt og
# RPE for styrkepas, som går tabt når Hevy synker til Garmin.
HEVY_API_KEY=

# --- Valgfrit -------------------------------------------------------------
GC_DB=~/.garmin-coach/coach.db
GC_TZ=Europe/Copenhagen
GC_MIN_WINDOW=60
